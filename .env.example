# =============================================================================
# Security (REQUIRED — must be changed from defaults before deployment)
# =============================================================================
# At least 32 characters each. Must NOT equal the default values below.
JWT_SECRET=abc123def456ghi789jkl012mno345pqr678stu901
SESSION_SECRET=xyz987wvu654tsr321qpo098nml765kji432hgf109

# Database Configuration
DATABASE_URL="file:/Users/lawrenceling/Development/circuit-breaker-portal/prisma/dev.db"

# =============================================================================
# F5 BIG-IP Integration (Phase 1 & 2)
# =============================================================================

# F5 BIG-IP Management Interface
F5_HOST=https://bigip-mgmt.bank.com
F5_USERNAME=admin
F5_PASSWORD=your-secure-password
F5_PARTITION=Common

# iControl REST API Settings
F5_VERIFY_SSL=true
F5_TOKEN_TIMEOUT=3600

# =============================================================================
# F5 SSL Orchestrator (SSLO) Configuration
# =============================================================================

# SSLO API Configuration
SSLO_ENABLED=true
SSLO_API_URL=https://bigip-mgmt.bank.com/mgmt/shared/ssl-orchestrator
SSLO_TOPOLOGY_NAME=swg-topology
SSLO_SERVICE_CHAIN=swg-service-chain

# =============================================================================
# F5 Secure Web Gateway (SWG) Configuration
# =============================================================================

# SWG Explicit Proxy Settings
SWG_ENABLED=true
SWG_EXPLICIT_PROXY_VS=vs_swg_explicit
SWG_EXPLICIT_PROXY_IP=10.1.10.51
SWG_EXPLICIT_PROXY_PORT=8080
SWG_INTERCEPT_PROFILE=swg-intercept
SWG_FORWARD_PROXY_PROFILE=swg-forward-proxy

# =============================================================================
# F5 Access Policy Manager (APM) Configuration
# =============================================================================

# APM Access Profile
APM_ENABLED=true
APM_ACCESS_PROFILE=swg-access-profile
APM_PER_REQUEST_POLICY=swg-per-request-policy

# NTLM Authentication
APM_NTLM_SERVERS=10.1.10.10,10.1.10.11
APM_NTLM_DOMAIN=CORP

# LDAP Authentication
APM_LDAP_SERVER=ldap://10.1.10.10:389
APM_LDAP_BIND_DN=cn=admin,dc=corp,dc=local
APM_LDAP_BIND_PASSWORD=your-ldap-password
APM_LDAP_SEARCH_BASE=dc=corp,dc=local

# Kerberos Authentication
APM_KERBEROS_REALM=CORP.LOCAL
APM_KERBEROS_KDC=10.1.10.10

# =============================================================================
# F5 Application Services 3 (AS3) Configuration
# =============================================================================

# AS3 Extension
AS3_ENABLED=true
AS3_API_URL=https://bigip-mgmt.bank.com/mgmt/shared/appsvcs
AS3_TENANT=SWG
AS3_APPLICATION=SecureWebGateway

# =============================================================================
# F5 Data Groups
# =============================================================================

# Data Group Names
DG_BLOCKED_URLS=dg-blocked-urls
DG_SSL_BYPASS=dg-ssl-bypass
DG_DENY_USERS=dg-deny-users
DG_ALLOWED_CATEGORIES=dg-allowed-categories

# =============================================================================
# F5 Logging & SSL Configuration
# =============================================================================

# High Speed Logging (HSL)
F5_HSL_POOL=hsl-pool
F5_REQUEST_LOGGING=swg-request-logging
F5_RESPONSE_LOGGING=swg-response-logging

# SSL/TLS Certificates
F5_CA_CERT=swg-ca-cert
F5_CA_KEY=swg-ca-key
F5_SSL_INTERCEPT_PROFILE=swg-ssl-intercept
F5_SSL_BYPASS_PROFILE=swg-ssl-bypass

# =============================================================================
# Authentication Integration (Phase 2)
# =============================================================================

# Active Directory / LDAP Configuration
AD_DOMAIN=corp.local
AD_SERVERS=10.1.10.10,10.1.10.11
LDAP_SERVER=ldap://10.1.10.10:389
LDAP_BIND_DN=cn=admin,dc=corp,dc=local
LDAP_BIND_PASSWORD=your-ldap-password
LDAP_SEARCH_BASE=dc=corp,dc=local

# Kerberos Configuration
KRB_REALM=CORP.LOCAL
KRB_KDC=10.1.10.10

# SAML Configuration
SAML_IDP_URL=https://sso.corp.local/saml
SAML_SP_ENTITY_ID=circuit-breaker-portal
SAML_CERT_PATH=/path/to/saml-cert.pem

# =============================================================================
# SIEM Integration (Phase 2)
# =============================================================================

# SIEM Export Configuration
SIEM_ENABLED=false
SIEM_SERVER=10.1.60.20
SIEM_PORT=514
SIEM_PROTOCOL=udp
SIEM_FORMAT=cef

# Splunk HEC (HTTP Event Collector)
SPLUNK_HEC_URL=https://splunk.bank.com:8088
SPLUNK_HEC_TOKEN=your-hec-token
SPLUNK_INDEX=swg_logs

# QRadar
QRADAR_CONSOLE=10.1.60.21
QRADAR_API_KEY=your-api-key

# =============================================================================
# ICAP Integration (Phase 2)
# =============================================================================

# ICAP Server Configuration (DLP/Anti-Malware)
ICAP_ENABLED=false
ICAP_SERVER_URI=icap://10.1.50.100:1344/reqmod
ICAP_PREVIEW_SIZE=1024
ICAP_FAIL_OPEN=true

# Multiple ICAP Servers (comma-separated)
ICAP_SERVERS=icap://10.1.50.100:1344/reqmod,icap://10.1.50.101:1344/reqmod

# =============================================================================
# Threat Intelligence Integration (Phase 2)
# =============================================================================

# Threat Feed Configuration
THREAT_INTEL_ENABLED=true
THREAT_INTEL_API_KEY=your-threat-intel-api-key
THREAT_INTEL_URL=https://api.threatintel.com/v1/feeds
THREAT_INTEL_INTERVAL=daily

# Additional Threat Feeds
VIRUSTOTAL_API_KEY=your-virustotal-api-key
ABUSE_CH_API_KEY=your-abuse-ch-api-key

# =============================================================================
# External Services (Phase 1 & 2)
# =============================================================================

# Certificate Management
CA_CERT_PATH=/path/to/ca-cert.pem
CA_KEY_PATH=/path/to/ca-key.pem

# Syslog Server
SYSLOG_SERVER=10.1.1.200
SYSLOG_PORT=514

# DNS Configuration
DNS_SERVER=10.1.1.53

# NTP Configuration
NTP_SERVER=10.1.1.123

# =============================================================================
# Application Settings
# =============================================================================

# Node Environment
NODE_ENV=development

# Session Secret
SESSION_SECRET=your-super-secret-session-key-change-in-production

# API Timeout (milliseconds)
API_TIMEOUT=30000

# Log Level
LOG_LEVEL=info

# =============================================================================
# Development Settings
# =============================================================================

# Vite Dev Server
VITE_PORT=5173

# Prisma Logging
PRISMA_LOG_QUERIES=false
